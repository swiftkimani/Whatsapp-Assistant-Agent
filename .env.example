# Copy to .env and fill in. .env is gitignored; never commit the real values.
# The bold rows in the README's Configuration table are the ones you must set.

# ---- Model (replies and Arianna) ----
ANTHROPIC_API_KEY=sk-ant-replace-me
ANTHROPIC_MODEL=claude-opus-5-5
# Thinking depth and token spend: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
# Ceiling for one reply. Thinking tokens are drawn from it, so keep it well
# above the length of the reply itself.
ANTHROPIC_MAX_TOKENS=4096

# The owner's name: the assistant replies AS this person, and treats a message
# that is just this name as someone calling for attention. Set it.
USER_NAME=

# ---- Dashboard ----
# Plaintext, for a dashboard only reachable over loopback.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_PASSWORD=
# An argon2id hash of the password instead. Required once the dashboard is
# reachable from anywhere but this machine: it is the only form that survives
# someone reading the environment. When set, the plaintext above is ignored.
# Generate with: python scripts/hash_password.py
# DASHBOARD_PASSWORD_HASH=
# true when reached through a tunnel, so per-IP lockouts use the real client IP
TRUST_PROXY=false
# Arianna's name (the wake-word spellings are in app/dashboard.html)
ASSISTANT_NAME=Arianna
# Short forms she also answers to, comma-separated. The wake-word spellings
# live in app/dashboard.html.
ASSISTANT_NICKNAMES=Arie

# ---- Bridge <-> backend ----
# Shared secret, checked in both directions. Generate it the same way.
BRIDGE_API_TOKEN=
BRIDGE_API_URL=http://127.0.0.1:3001
BRIDGE_API_PORT=3001
BACKEND_URL=http://localhost:8000/webhook
# The bridge's send API binds loopback, so nothing off this machine can reach
# it. Only containers change that: under compose the backend is a different
# host, and docker-compose.yaml sets this to 0.0.0.0 on a private network.
# BRIDGE_API_HOST=127.0.0.1

# ---- Browser for the bridge ----
# whatsapp-web.js drives a real Chrome. Puppeteer's own browser download failed
# to extract here, so point it at the installed Chrome instead and install the
# bridge with: PUPPETEER_SKIP_DOWNLOAD=true npm install
# Quoted because the path contains spaces and scripts/dev.sh sources this file.
PUPPETEER_EXECUTABLE_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"

# ---- Who gets answered ----
# Comma-separated phone numbers, no "+". EMPTY MEANS EVERYONE: set this before
# going live, or the assistant replies to anyone who messages you.
ALLOWED_CONTACTS=
ALLOW_GROUPS=false
# Link by typing an 8-character code instead of scanning a QR. Set this to the
# number of the account being linked, digits only, no "+". The code lasts about
# three minutes; a QR lasts twenty seconds. Leave empty to use the QR.
# PAIRING_NUMBER=
# The WhatsApp Web build the bridge loads. The library pins an old one, and
# WhatsApp refuses to link a NEW device on a stale build while existing
# sessions keep working — it reports that as "Couldn't link device". Pick a
# recent one from github.com/wppconnect-team/wa-version/tree/main/html
# WA_WEB_VERSION=2.3000.1047561935-alpha
# Where contacts.json lives. The project root by default; compose points both
# containers at one copy on a shared volume.
# CONTACTS_FILE=

# ---- Voice notes and dictation (faster-whisper, local) ----
# Whisper's language hint. English does better than Swahili on short clips,
# and most Kenyan voice notes are English or a mix. "sw" biases the other way.
STT_LANGUAGE=en
WHISPER_MODEL_SIZE=small
DASHBOARD_WHISPER_SIZE=small
# Send voice replies on WhatsApp when someone sends a voice note
REPLY_WITH_VOICE=false

# ---- Spoken replies in the dashboard ----
# edge = free Microsoft voices, no key. openai = an instructable voice, paid per
# use, and the only thing here that needs OPENAI_API_KEY.
TTS_PROVIDER=edge
DASHBOARD_VOICE_SW=sw-KE-ZuriNeural
DASHBOARD_VOICE_EN=en-KE-AsiliaNeural
# OPENAI_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=coral
# OPENAI_TTS_STYLE=

# ---- Storage and retrieval ----
MESSAGE_RETENTION_DAYS=30
STYLE_RETRIEVAL=true
EMBEDDING_MODEL=intfloat/multilingual-e5-base
